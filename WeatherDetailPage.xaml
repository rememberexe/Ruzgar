<ContentPage
    x:Class="Ruzgar.WeatherDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:Ruzgar.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#020617"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{Binding BackgroundStartColor}" Offset="0.0" />
            <GradientStop Color="{Binding BackgroundMiddleColor}" Offset="0.45" />
            <GradientStop Color="{Binding BackgroundEndColor}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <controls:AtmosphereView
            WeatherCode="{Binding WeatherCode}"
            AccentColor="{Binding AccentColor}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Opacity="0.72" />

        <Border
            WidthRequest="320"
            HeightRequest="320"
            Margin="-150,-120,0,0"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Opacity="0.34"
            StrokeThickness="0"
            InputTransparent="True">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#66FFFFFF" Offset="0.0" />
                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="180" />
            </Border.StrokeShape>
        </Border>

        <ScrollView>
            <VerticalStackLayout
                x:Name="DetailRoot"
                Padding="24,48,24,30"
                Spacing="18"
                Opacity="0"
                TranslationY="24">

                <!-- Üst bar -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                    <Border
                        x:Name="BackButton"
                        WidthRequest="48"
                        HeightRequest="48"
                        Stroke="#45FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#24FFFFFF">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BackButton_Tapped" />
                        </Border.GestureRecognizers>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <Label
                            Text="‹"
                            TextColor="White"
                            FontSize="34"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Margin="0,-4,0,0" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="Günlük analiz"
                            TextColor="White"
                            FontSize="25"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding City}"
                            TextColor="#D6E2F0"
                            FontSize="13"
                            LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Akıllı özet -->
                <Border
                    Padding="22"
                    Stroke="#50FFFFFF"
                    StrokeThickness="1">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{Binding CardStartColor}" Offset="0.0" />
                            <GradientStop Color="{Binding CardEndColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#AA000000"
                            Offset="0,18"
                            Radius="36"
                            Opacity="0.58" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="5">
                                <Label
                                    Text="Bugün ne kadar rahat?"
                                    TextColor="#D6E2F0"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding ComfortScoreText}"
                                    TextColor="White"
                                    FontSize="48"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding ComfortComment}"
                                    TextColor="White"
                                    FontSize="15"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <controls:WeatherBadgeView
                                Grid.Column="1"
                                WidthRequest="92"
                                HeightRequest="92"
                                WeatherCode="{Binding WeatherCode}"
                                AccentColor="{Binding AccentColor}"
                                HorizontalOptions="End"
                                VerticalOptions="Start" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <Border
                                Padding="14"
                                BackgroundColor="#18FFFFFF"
                                Stroke="#22FFFFFF"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="3">
                                    <Label
                                        Text="Bugün aralık"
                                        TextColor="#CBD5E1"
                                        FontSize="11" />

                                    <Label
                                        Text="{Binding TodayRangeText}"
                                        TextColor="White"
                                        FontSize="18"
                                        FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="14"
                                BackgroundColor="#18FFFFFF"
                                Stroke="#22FFFFFF"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="3">
                                    <Label
                                        Text="Durum"
                                        TextColor="#CBD5E1"
                                        FontSize="11" />

                                    <Label
                                        Text="{Binding Description}"
                                        TextColor="White"
                                        FontSize="18"
                                        FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <Border
                            Grid.Row="2"
                            Padding="15"
                            BackgroundColor="#18FFFFFF"
                            Stroke="#22FFFFFF"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="5">
                                <Label
                                    Text="Kıyafet önerisi"
                                    TextColor="#CBD5E1"
                                    FontSize="12" />

                                <Label
                                    Text="{Binding OutfitSuggestion}"
                                    TextColor="White"
                                    FontSize="14"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </Border>

                <!-- Gün planı -->
                <Border
                    Padding="18"
                    Stroke="#35FFFFFF"
                    StrokeThickness="1"
                    BackgroundColor="#20FFFFFF">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeThickness="0"
                            BackgroundColor="#20FFFFFF"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>

                            <Label
                                Text="✦"
                                TextColor="{Binding AccentColor}"
                                FontSize="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label
                                Text="Gün planı"
                                TextColor="#CBD5E1"
                                FontSize="12" />

                            <Label
                                Text="{Binding DayPlanSuggestion}"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Saat öne çıkanları -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                    <Border
                        Padding="17"
                        Stroke="#35FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#20FFFFFF">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="En sıcak saat"
                                TextColor="#CBD5E1"
                                FontSize="12" />

                            <Label
                                Text="{Binding WarmestHourText}"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="17"
                        Stroke="#35FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#20FFFFFF">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="En serin saat"
                                TextColor="#CBD5E1"
                                FontSize="12" />

                            <Label
                                Text="{Binding ColdestHourText}"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Risk kartları -->
                <Label
                    Text="Risk ve öneriler"
                    TextColor="White"
                    FontSize="19"
                    FontAttributes="Bold"
                    Margin="2,8,0,0" />

                <VerticalStackLayout Spacing="12">

                    <Border Padding="16" Stroke="#35FFFFFF" StrokeThickness="1" BackgroundColor="#18FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="☔" FontSize="25" VerticalOptions="Start" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Yağış" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding RainAdvice}" TextColor="#D6E2F0" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Padding="16" Stroke="#35FFFFFF" StrokeThickness="1" BackgroundColor="#18FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="☀️" FontSize="25" VerticalOptions="Start" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="UV" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding UvAdvice}" TextColor="#D6E2F0" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Padding="16" Stroke="#35FFFFFF" StrokeThickness="1" BackgroundColor="#18FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="🌬️" FontSize="25" VerticalOptions="Start" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Rüzgar" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding WindAdvice}" TextColor="#D6E2F0" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Padding="16" Stroke="#35FFFFFF" StrokeThickness="1" BackgroundColor="#18FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="👁️" FontSize="25" VerticalOptions="Start" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Görüş" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding VisibilityAdvice}" TextColor="#D6E2F0" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- Saatlik akış -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,8,0,0">
                    <Label
                        Text="Saatlik akış"
                        TextColor="White"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <Label
                        Grid.Column="1"
                        Text="12 saat"
                        TextColor="#CBD5E1"
                        FontSize="12"
                        VerticalOptions="Center" />
                </Grid>

                <CollectionView
                    ItemsSource="{Binding HourlyForecasts}"
                    ItemsLayout="HorizontalList"
                    HeightRequest="122"
                    HorizontalScrollBarVisibility="Never">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                WidthRequest="96"
                                HeightRequest="108"
                                Margin="0,0,18,0"
                                Padding="12"
                                Stroke="#36FFFFFF"
                                StrokeThickness="1"
                                BackgroundColor="#20FFFFFF">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="30" />
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                    <Label
                                        Text="{Binding TimeText}"
                                        TextColor="#E2E8F0"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding Icon}"
                                        FontSize="30"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />

                                    <Label
                                        Grid.Row="2"
                                        Text="{Binding TemperatureText}"
                                        TextColor="White"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Haftalık özet -->
                <Border
                    Padding="17"
                    Stroke="#35FFFFFF"
                    StrokeThickness="1"
                    BackgroundColor="#20FFFFFF">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Haftalık özet"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding WeeklyHighlightText}"
                            TextColor="#D6E2F0"
                            FontSize="14" />

                        <Label
                            Text="{Binding WeeklyColdText}"
                            TextColor="#D6E2F0"
                            FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Stroke="#35FFFFFF"
                    StrokeThickness="1"
                    Padding="8"
                    BackgroundColor="#18FFFFFF">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding DailyForecasts}"
                        Spacing="4">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="#12FFFFFF"
                                    StrokeThickness="0"
                                    Padding="13">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                        <Label
                                            Text="{Binding DayText}"
                                            TextColor="White"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Icon}"
                                            FontSize="24"
                                            VerticalOptions="Center" />

                                        <HorizontalStackLayout
                                            Grid.Column="2"
                                            Spacing="4"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding MaxTemperatureText}"
                                                TextColor="White"
                                                FontSize="16"
                                                FontAttributes="Bold" />

                                            <Label
                                                Text="/"
                                                TextColor="#94A3B8"
                                                FontSize="16" />

                                            <Label
                                                Text="{Binding MinTemperatureText}"
                                                TextColor="#CBD5E1"
                                                FontSize="16" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
