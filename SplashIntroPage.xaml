<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Ruzgar.Controls"
    x:Class="Ruzgar.SplashIntroPage"
    BackgroundColor="#020617"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0" />
            <GradientStop Color="#1E3A8A" Offset="0.45" />
            <GradientStop Color="#020617" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <controls:AtmosphereView
            WeatherCode="1"
            AccentColor="#60A5FA"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Opacity="0.72" />

        <Border
            WidthRequest="340"
            HeightRequest="340"
            Margin="-150,-120,0,0"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Opacity="0.35"
            StrokeThickness="0"
            InputTransparent="True">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#93C5FD" Offset="0.0" />
                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="180" />
            </Border.StrokeShape>
        </Border>

        <Border
            WidthRequest="300"
            HeightRequest="300"
            Margin="0,0,-140,-160"
            HorizontalOptions="End"
            VerticalOptions="End"
            Opacity="0.25"
            StrokeThickness="0"
            InputTransparent="True">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#60A5FA" Offset="0.0" />
                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="160" />
            </Border.StrokeShape>
        </Border>

        <VerticalStackLayout
            x:Name="SplashContent"
            Padding="28"
            Spacing="24"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Opacity="0"
            TranslationY="36"
            Scale="0.94">

            <Grid
                WidthRequest="150"
                HeightRequest="150"
                HorizontalOptions="Center">

                <Border
                    x:Name="LogoGlow"
                    WidthRequest="150"
                    HeightRequest="150"
                    Opacity="0.65"
                    StrokeThickness="0">

                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" Radius="0.7">
                            <GradientStop Color="#60A5FA" Offset="0.0" />
                            <GradientStop Color="#2260A5FA" Offset="0.55" />
                            <GradientStop Color="#0060A5FA" Offset="1.0" />
                        </RadialGradientBrush>
                    </Border.Background>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="80" />
                    </Border.StrokeShape>
                </Border>

                <Border
                    x:Name="LogoCard"
                    WidthRequest="112"
                    HeightRequest="112"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#55FFFFFF"
                    StrokeThickness="1"
                    Padding="0">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#55FFFFFF" Offset="0.0" />
                            <GradientStop Color="#1660A5FA" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="36" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#90000000"
                            Offset="0,18"
                            Radius="34"
                            Opacity="0.42" />
                    </Border.Shadow>

                    <controls:WeatherBadgeView
                        x:Name="LogoIcon"
                        WidthRequest="82"
                        HeightRequest="82"
                        WeatherCode="2"
                        AccentColor="#60A5FA"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

            </Grid>

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label
                    x:Name="TitleLabel"
                    Text="Rüzgar"
                    TextColor="White"
                    FontSize="44"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="SubtitleLabel"
                    Text="Havayı önceden hisset"
                    TextColor="#DDEBFF"
                    FontSize="15"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Grid
                WidthRequest="210"
                HeightRequest="5"
                HorizontalOptions="Center"
                Margin="0,16,0,0">

                <Border
                    BackgroundColor="#22FFFFFF"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                </Border>

                <Border
                    x:Name="ProgressFill"
                    WidthRequest="0"
                    HorizontalOptions="Start"
                    StrokeThickness="0">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#BFDBFE" Offset="0.0" />
                            <GradientStop Color="#60A5FA" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                </Border>
            </Grid>

            <Label
                x:Name="LoadingLabel"
                Text="Hava hazırlanıyor..."
                TextColor="#BFD7FF"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Opacity="0.85" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
